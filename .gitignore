# Development Environment Overrides (If you add any local environment vars later)
.env
.env.local

# OpenSpec source artifacts are intentionally tracked:
# - openspec/config.yaml
# - openspec/specs/**
# - openspec/changes/**, including archived changes and per-change .openspec.yaml
#
# Ignore only local/runtime state and generated AI-tool integrations.
.openspec/
openspec/.cache/
openspec/.tmp/
openspec/worksets/

# Generated by `openspec init --tools ...` / `openspec update`.
.agents/skills/openspec-*/
.agents/skills/.openspec-target
.cline/skills/openspec-*/
.clinerules/workflows/opsx-*.md
